{
  "name": "@tryatlas/design",
  "version": "0.1.0",
  "description": "Atlas's design system: primitives, tokens, themes and the ratchet, shared by desktop, web and docs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryatlas/design.git"
  },
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "keys.toml",
    "themes",
    "theme-rules",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/styles.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./ratchet": {
      "types": "./dist/ratchet/index.d.ts",
      "import": "./dist/ratchet/index.js"
    },
    "./keys.toml": "./keys.toml",
    "./themes/*": "./themes/*",
    "./theme-rules/*": "./theme-rules/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "theme": "bun scripts/generate-theme.ts",
    "theme:check": "bun scripts/generate-theme.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:consumer": "bun run build && cd fixtures/consumer && bun install && bun run check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.0",
    "lucide-react": "^1.48.0",
    "motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cobe": "^2.0.1",
    "react-resizable-panels": "^4.15.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/cli": "^4.3.4",
    "@tanstack/react-virtual": "^3.14.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
